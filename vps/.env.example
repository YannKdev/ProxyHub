# Copier en .env puis remplir. Les valeurs vides sont obligatoires.
# Pour générer un secret : openssl rand -hex 32

# Identifiants des proxys, communs à toutes les sorties
PROXY_USER=
PROXY_PASSWORD=

# Jeton de l'API de contrôle (32 caractères minimum)
API_TOKEN=
# Nom de domaine de l'API (enregistrement A vers le VPS), servi en HTTPS par Caddy
API_DOMAIN=

# Clé privée NordLynx (voir README)
WIREGUARD_PRIVATE_KEY=
# Pays des serveurs NordVPN au démarrage. Le client peut en changer à la rotation.
SERVER_COUNTRIES=France

# Clé d'API du serveur de contrôle de Gluetun
GLUETUN_API_KEY=

TZ=Europe/Paris
