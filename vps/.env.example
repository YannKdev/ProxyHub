# Copier en .env puis remplir. Les valeurs vides sont obligatoires.
# Pour générer un secret : openssl rand -hex 32

# Identifiants des proxys, communs à toutes les sorties
PROXY_USER=
PROXY_PASSWORD=

# Jeton de l'API de contrôle (32 caractères minimum)
API_TOKEN=
# Nom de domaine de l'API (enregistrement A vers le VPS), servi en HTTPS par Caddy
API_DOMAIN=

# Clé privée NordLynx (voir README)
WIREGUARD_PRIVATE_KEY=
# Pays des serveurs NordVPN au démarrage. Le client peut en changer à la rotation.
SERVER_COUNTRIES=France

# Clé d'API du serveur de contrôle de Gluetun (commune à toutes les sorties VPN)
GLUETUN_API_KEY=

# Sorties CyberGhost, facultatives : décommenter et remplir (voir README).
# COMPOSE_PROFILES=cyberghost-1,cyberghost-2,cyberghost-3,cyberghost-4
# CYBERGHOST_USER=
# CYBERGHOST_PASSWORD=
# Certificat et clé client : partie base64 seule, sur une ligne
# CYBERGHOST_CERT=
# CYBERGHOST_KEY=
# CYBERGHOST_COUNTRIES=France
# Sorties 2 à 4 : mêmes valeurs que la première, sauf celles définies ici (idem CYBERGHOST_3_*, _4_*)
# CYBERGHOST_2_USER=
# CYBERGHOST_2_PASSWORD=
# CYBERGHOST_2_CERT=
# CYBERGHOST_2_KEY=
# CYBERGHOST_2_COUNTRIES=France

# Sortie mobile (téléphone Android rooté), facultative : ajouter mobile-1 à COMPOSE_PROFILES.
# Clé publique affichée par phone/install.sh, sur une ligne : ssh-ed25519 AAAA... proxyhub-phone
# TUNNEL_AUTHORIZED_KEY=

TZ=Europe/Paris
