# Copier en .env puis remplir. Les valeurs vides sont obligatoires.
# Pour générer un secret : openssl rand -hex 32

# Identifiants des proxys, communs à toutes les sorties
PROXY_USER=
PROXY_PASSWORD=

# Clé privée NordLynx (voir README)
WIREGUARD_PRIVATE_KEY=
# Pays des serveurs NordVPN, séparés par des virgules. Vide : tous les pays.
SERVER_COUNTRIES=France

# Clé d'API du serveur de contrôle de Gluetun
GLUETUN_API_KEY=

TZ=Europe/Paris
